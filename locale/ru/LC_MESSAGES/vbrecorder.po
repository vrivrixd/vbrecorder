"{maximo} мс; по умолчанию {padrao}."

msgid ""
"O tamanho do buffer deve ser um número entre {minimo} e {maximo} "
"milissegundos."
msgstr "Размер буфера должен быть числом от {minimo} до {maximo} миллисекунд."

