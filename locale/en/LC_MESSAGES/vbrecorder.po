msgid "&Reproduzir tons ao pausar, continuar ou parar sozinha"
msgstr "Play tones when &it pauses, resumes or stops by itself"

msgid "Dete&cção de Silêncio..."
msgstr "Silence De&tection..."

msgid "A detecção de silêncio precisa de ao menos uma fonte que não seja áudio de fundo."
msgstr "Silence detection needs at least one source that is not background audio."

msgid "Permitir Múltiplas I&nstâncias"
msgstr "Allow multiple &instances"

msgid "Gravar em uma &Subpasta"
msgstr "Record in a Su&bfolder"

msgid "Renomear &Gravação"
msgstr "Re&name Recording"

msgid "Ao Termi&nar a Gravação:"
msgstr "When the Record&ing Ends:"

msgid "Não fazer nada"
msgstr "Do nothing"

msgid "Fechar o programa"
msgstr "Close the program"

msgid "Hibernar"
msgstr "Hibernate"

msgid "Suspender"
msgstr "Sleep"

msgid "Desligar"
msgstr "Shut down"

msgid "Reiniciar"
msgstr "Restart"

msgid "Não foi possível fazer o que foi escolhido ao terminar a gravação:\n{erro}"
msgstr "Could not do what was chosen for when the recording ends:\n{erro}"

msgid "Renomear Gravação"
msgstr "Rename Recording"

msgid "&Pasta:"
msgstr "&Folder:"

msgid "&Arquivo {n}:"
msgstr "File &{n}:"

msgid "O nome não pode ficar vazio, terminar em ponto ou espaço, nem ter os caracteres \\ / : * ? \" < > |"
msgstr "The name cannot be empty, end in a dot or a space, or contain the characters \\ / : * ? \" < > |"

msgid "Já existe um arquivo ou pasta com esse nome:\n{caminho}"
msgstr "A file or folder with that name already exists:\n{caminho}"

msgid "Não foi possível renomear:\n"
msgstr "Could not rename:\n"

msgid "Renomear Gravação:"
msgstr "Rename Recording:"

msgid "Re&produzir Enquanto Grava"
msgstr "Pl&ay While Recording"

msgid "Atraso da Fo&nte (ms):"
msgstr "Source Dela&y (ms):"

msgid "Em branco, sem atraso. Até {maximo} ms, para alinhar uma fonte que chega antes das outras na gravação."
msgstr "Empty means no delay. Up to {maximo} ms, to line up a source that comes in before the others in the recording."

msgid "O atraso deve ser um número de 0 a {maximo} ms, ou ficar em branco."
msgstr "The delay must be a number from 0 to {maximo} ms, or be left empty."

msgid "Antecipar o Pró&ximo Arquivo:"
msgstr "Start &the Next File Early:"

msgid "Fade ao Te&rminar o Arquivo:"
msgstr "Fade Out at the E&nd of the File:"

msgid "Fade ao Co&meçar o Arquivo:"
msgstr "Fade In at &the Start of the File:"
